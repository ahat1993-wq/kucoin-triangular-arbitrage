# Application Environment
APP_ENV=dev
APP_NAME=kucoin_triangular_bot
LOG_LEVEL=INFO

# KuCoin API Endpoints
KUCOIN_REST_BASE=https://api.kucoin.com
KUCOIN_WS_BASE=wss://ws-api-spot.kucoin.com
KUCOIN_PUSH_BASE=wss://x-push-spot.kucoin.com

# Market Configuration
BASE_ASSET=USDT
SUPPORTED_QUOTE_ASSETS=USDT,BTC,ETH,KCS,SOL,BNB
MIN_QUOTE_VOLUME=0
MIN_LIQUIDITY_USD=0

# Risk and Control Parameters
MIN_ESTIMATED_NET_RETURN=0.0005
MAX_SLIPPAGE=0.01
MAX_CYCLE_CAPITAL=100
MAX_SIMULATIONS=4
MAX_MARKET_DATA_AGE_SECONDS=10
MAX_CONSECUTIVE_FAILURES=5
EMERGENCY_PAUSE=false

# Paper Trading
STARTING_CAPITAL=100
PAPER_CURRENCY=USDT

# Database
DB_PATH=data/kucoin_bot.sqlite
CSV_EXPORT_DIR=data/reports

# Network Configuration
REQUEST_TIMEOUT=10.0
WS_HEARTBEAT_INTERVAL=20.0
WS_RECONNECT_DELAY=3.0

# Dashboard Security
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-in-production
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_PORT=8000
DASHBOARD_HOST=127.0.0.1